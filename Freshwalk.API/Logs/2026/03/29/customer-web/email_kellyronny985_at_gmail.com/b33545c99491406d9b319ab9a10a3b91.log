=== DATABASE COMMANDS ===
SELECT f."CustomerReference"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__customerId_0
LIMIT 1
  -- @__customerId_0=35040583-dcf4-4af7-abe2-6c7777644a6e
---
SELECT b."Id", b."AddOns", b."BookingReference", b."BundleDiscountPercent", b."CreatedAt", b."CustomerId", b."DiscountAmountKes", b."NubuckLines", b."OfficialLeatherLines", b."PickupAddress", b."PickupLatitude", b."PickupLocationUrl", b."PickupLongitude", b."PriceKes", b."SneakersLines", b."Status", b."SubtotalBeforeDiscountKes", b."SuedeLines", b."TotalPairs", p."Id", p."Amount", p."BookingId", p."CreatedAt", p."MpesaCheckoutRequestId", p."MpesaMerchantRequestId", p."MpesaReceipt", p."PayerPhoneNumber", p."PaymentReference", p."Status", o."Id", o."AgentId", o."BookingId", o."CleaningCompletedAt", o."CleaningStartedAt", o."CustomerId", o."DeliveredAt", o."DeliveryOtp", o."DeliveryOtpExpiresAt", o."DeliveryOtpVerifiedAt", o."OrderReference", o."PickedUpAt", o."PickupOtp", o."PickupOtpExpiresAt", o."PickupOtpVerifiedAt", o."Status"
FROM "Bookings" AS b
LEFT JOIN "Payments" AS p ON b."Id" = p."BookingId"
LEFT JOIN "Orders" AS o ON b."Id" = o."BookingId"
WHERE b."CustomerId" = @__customerId_0
ORDER BY b."CreatedAt" DESC
  -- @__customerId_0=35040583-dcf4-4af7-abe2-6c7777644a6e
---
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__p_0
LIMIT 1
  -- @__p_0=35040583-dcf4-4af7-abe2-6c7777644a6e
---

