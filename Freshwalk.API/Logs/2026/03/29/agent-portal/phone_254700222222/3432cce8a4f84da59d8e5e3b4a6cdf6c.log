=== DATABASE COMMANDS ===
SELECT b."Id", b."AddOns", b."BookingReference", b."BundleDiscountPercent", b."CreatedAt", b."CustomerId", b."DiscountAmountKes", b."NubuckLines", b."OfficialLeatherLines", b."PickupAddress", b."PickupLatitude", b."PickupLocationUrl", b."PickupLongitude", b."PriceKes", b."SneakersLines", b."Status", b."SubtotalBeforeDiscountKes", b."SuedeLines", b."TotalPairs"
FROM "Bookings" AS b
---
SELECT o."Id", o."AgentId", o."BookingId", o."CleaningCompletedAt", o."CleaningStartedAt", o."CustomerId", o."DeliveredAt", o."DeliveryOtp", o."DeliveryOtpExpiresAt", o."DeliveryOtpVerifiedAt", o."OrderReference", o."PickedUpAt", o."PickupOtp", o."PickupOtpExpiresAt", o."PickupOtpVerifiedAt", o."Status"
FROM "Orders" AS o
WHERE o."BookingId" = ANY (@__bookingIds_0)
  -- @__bookingIds_0=System.Collections.Generic.List`1[System.Guid]
---
SELECT COALESCE(sum(p."Amount"), 0.0)
FROM "Payments" AS p
WHERE p."BookingId" = ANY (@__bookingIds_0) AND p."Status" = 'Success'
  -- @__bookingIds_0=System.Collections.Generic.List`1[System.Guid]
---
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__p_0
LIMIT 1
  -- @__p_0=d3ea9e8e-baeb-4f01-bbcd-a712a07e43c5
---

