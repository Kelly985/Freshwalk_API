=== DATABASE COMMANDS ===
SELECT b."Id", b."AddOns", b."BookingReference", b."BundleDiscountPercent", b."CreatedAt", b."CustomerId", b."DiscountAmountKes", b."NubuckLines", b."OfficialLeatherLines", b."PickupAddress", b."PickupLatitude", b."PickupLocationUrl", b."PickupLongitude", b."PriceKes", b."SneakersLines", b."Status", b."SubtotalBeforeDiscountKes", b."SuedeLines", b."TotalPairs", f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName", p."Id", p."Amount", p."BookingId", p."CreatedAt", p."MpesaCheckoutRequestId", p."MpesaMerchantRequestId", p."MpesaReceipt", p."PayerPhoneNumber", p."PaymentReference", p."Status", o."Id", o."AgentId", o."BookingId", o."CleaningCompletedAt", o."CleaningStartedAt", o."CustomerId", o."DeliveredAt", o."DeliveryOtp", o."DeliveryOtpExpiresAt", o."DeliveryOtpVerifiedAt", o."OrderReference", o."PickedUpAt", o."PickupOtp", o."PickupOtpExpiresAt", o."PickupOtpVerifiedAt", o."Status"
FROM "Bookings" AS b
INNER JOIN "FreshwalkUsers" AS f ON b."CustomerId" = f."Id"
LEFT JOIN "Payments" AS p ON b."Id" = p."BookingId"
LEFT JOIN "Orders" AS o ON b."Id" = o."BookingId"
ORDER BY b."CreatedAt" DESC
---
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__p_0
LIMIT 1
  -- @__p_0=d3ea9e8e-baeb-4f01-bbcd-a712a07e43c5
---

