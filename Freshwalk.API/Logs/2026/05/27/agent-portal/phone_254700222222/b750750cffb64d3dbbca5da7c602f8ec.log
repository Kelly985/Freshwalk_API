=== DATABASE COMMANDS ===
SELECT f."Id", f."ConcurrencyStamp", f."Name", f."NormalizedName"
FROM "FreshwalkRoles" AS f
WHERE f."NormalizedName" = @__normalizedRoleName_0
LIMIT 2
  -- @__normalizedRoleName_0=RIDER
---
SELECT f0."Id", f0."AccessFailedCount", f0."Address", f0."ConcurrencyStamp", f0."CreatedAt", f0."CustomerReference", f0."Email", f0."EmailConfirmed", f0."FullName", f0."IsActive", f0."LockoutEnabled", f0."LockoutEnd", f0."NormalizedEmail", f0."NormalizedUserName", f0."PasswordHash", f0."PhoneNumber", f0."PhoneNumberConfirmed", f0."SecurityStamp", f0."TwoFactorEnabled", f0."UserName"
FROM "FreshwalkUserRoles" AS f
INNER JOIN "FreshwalkUsers" AS f0 ON f."UserId" = f0."Id"
WHERE f."RoleId" = @__role_Id_0
  -- @__role_Id_0=285df5e0-a4e0-4e10-8db0-f481446cd241
---
SELECT r."Id", r."BikeRegistration", r."CloudinaryPublicIdIdBack", r."CloudinaryPublicIdIdFront", r."CloudinaryPublicIdSelfie", r."EmergencyContactName", r."EmergencyContactPhone", r."IdBackUrl", r."IdFrontUrl", r."IsAvailable", r."Notes", r."SelfieUrl", r."UserId"
FROM "RiderProfiles" AS r
---
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__p_0
LIMIT 1
  -- @__p_0=d3ea9e8e-baeb-4f01-bbcd-a712a07e43c5
---

