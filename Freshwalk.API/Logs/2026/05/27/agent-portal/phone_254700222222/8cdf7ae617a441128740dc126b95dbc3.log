=== DATABASE COMMANDS ===
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName", r."Id", r."BikeRegistration", r."CloudinaryPublicIdIdBack", r."CloudinaryPublicIdIdFront", r."CloudinaryPublicIdSelfie", r."EmergencyContactName", r."EmergencyContactPhone", r."IdBackUrl", r."IdFrontUrl", r."IsAvailable", r."Notes", r."SelfieUrl", r."UserId"
FROM "FreshwalkUsers" AS f
LEFT JOIN "RiderProfiles" AS r ON f."Id" = r."UserId"
WHERE EXISTS (
    SELECT 1
    FROM "FreshwalkUserRoles" AS f0
    WHERE f0."UserId" = f."Id" AND EXISTS (
        SELECT 1
        FROM "FreshwalkRoles" AS f1
        WHERE f1."Id" = f0."RoleId" AND f1."Name" = 'Rider'))
ORDER BY f."CreatedAt" DESC
---
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__p_0
LIMIT 1
