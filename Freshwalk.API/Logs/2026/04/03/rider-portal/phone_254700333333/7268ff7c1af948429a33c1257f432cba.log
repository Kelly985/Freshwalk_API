=== DATABASE COMMANDS ===
SELECT s."Id", s."AssignedAt", s."AssignmentReference", s."AssignmentType", s."CompletedAt", s."Notes", s."OrderId", s."RiderId", s."Status", s."Id0", s."AgentId", s."BookingId", s."CleaningCompletedAt", s."CleaningStartedAt", s."CustomerId", s."DeliveredAt", s."DeliveryOtp", s."DeliveryOtpExpiresAt", s."DeliveryOtpVerifiedAt", s."OrderReference", s."PickedUpAt", s."PickupOtp", s."PickupOtpExpiresAt", s."PickupOtpVerifiedAt", s."Status0", b."Id", b."AddOns", b."AppliedPromotions", b."BookingReference", b."BundleDiscountPercent", b."CanvasLines", b."CreatedAt", b."CustomerId", b."DiscountAmountKes", b."NubuckLines", b."PickupAddress", b."PickupLatitude", b."PickupLocationUrl", b."PickupLongitude", b."PriceKes", b."PromotionalDiscountKes", b."ShoesSubtotalGrossKes", b."SneakersLines", b."Status", b."SubtotalBeforeDiscountKes", b."SuedeLines", b."TotalPairs", f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName", p."Id", p."Amount", p."BookingId", p."CreatedAt", p."MpesaCheckoutRequestId", p."MpesaMerchantRequestId", p."MpesaReceipt", p."PayerPhoneNumber", p."PaymentReference", p."Status"
FROM (
    SELECT o."Id", o."AssignedAt", o."AssignmentReference", o."AssignmentType", o."CompletedAt", o."Notes", o."OrderId", o."RiderId", o."Status", o0."Id" AS "Id0", o0."AgentId", o0."BookingId", o0."CleaningCompletedAt", o0."CleaningStartedAt", o0."CustomerId", o0."DeliveredAt", o0."DeliveryOtp", o0."DeliveryOtpExpiresAt", o0."DeliveryOtpVerifiedAt", o0."OrderReference", o0."PickedUpAt", o0."PickupOtp", o0."PickupOtpExpiresAt", o0."PickupOtpVerifiedAt", o0."Status" AS "Status0", COALESCE(o0."DeliveredAt", o0."PickedUpAt", o."AssignedAt") AS c
    FROM "OrderRiderAssignments" AS o
    INNER JOIN "Orders" AS o0 ON o."OrderId" = o0."Id"
    WHERE o."RiderId" = @__riderId_0 AND (o0."DeliveredAt" IS NOT NULL OR (o."AssignmentType" = 'Pickup' AND o0."Status" IN ('AtShop', 'CleaningInProgress', 'AwaitingDeliveryRider', 'DeliveryRiderAssigned', 'Delivered')))
    ORDER BY COALESCE(o0."DeliveredAt", o0."PickedUpAt", o."AssignedAt") DESC
    LIMIT @__p_1
) AS s
INNER JOIN "Bookings" AS b ON s."BookingId" = b."Id"
INNER JOIN "FreshwalkUsers" AS f ON b."CustomerId" = f."Id"
LEFT JOIN "Payments" AS p ON b."Id" = p."BookingId"
ORDER BY s.c DESC
  -- @__riderId_0=9da150f3-8997-4d83-984f-8c917207220c, @__p_1=200
---
SELECT f."Id", f."AccessFailedCount", f."Address", f."ConcurrencyStamp", f."CreatedAt", f."CustomerReference", f."Email", f."EmailConfirmed", f."FullName", f."IsActive", f."LockoutEnabled", f."LockoutEnd", f."NormalizedEmail", f."NormalizedUserName", f."PasswordHash", f."PhoneNumber", f."PhoneNumberConfirmed", f."SecurityStamp", f."TwoFactorEnabled", f."UserName"
FROM "FreshwalkUsers" AS f
WHERE f."Id" = @__p_0
LIMIT 1
  -- @__p_0=9da150f3-8997-4d83-984f-8c917207220c
---

