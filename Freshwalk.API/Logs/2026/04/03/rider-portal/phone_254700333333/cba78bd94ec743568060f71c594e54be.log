FROM "OrderRiderAssignments" AS o
INNER JOIN "Orders" AS o0 ON o."OrderId" = o0."Id"
INNER JOIN "Bookings" AS b ON o0."BookingId" = b."Id"
INNER JOIN "FreshwalkUsers" AS f ON b."CustomerId" = f."Id"
LEFT JOIN "Payments" AS p ON b."Id" = p."BookingId"
WHERE o."RiderId" = @__riderId_0 AND ((o."AssignmentType" = 'Pickup' AND o0."Status" IN ('PickupRiderAssigned', 'InTransitToShop')) OR (o."AssignmentType" = 'Delivery' AND o0."Status" IN ('DeliveryRiderAssigned', 'InTransitToCustomer')))
ORDER BY o."AssignedAt" DESC
